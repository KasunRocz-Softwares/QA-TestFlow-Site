# QA TestFlow — settings for deploy/docker-compose.yml
# Copy this file to .env next to docker-compose.yml, then fill in the two REQUIRED values.

# ── Required ──────────────────────────────────────────────────────
# Database password. Generate one with:  openssl rand -base64 24
POSTGRES_PASSWORD=
# Signs sign-in tokens. Use a long random value:  openssl rand -base64 48
JWT_SECRET=

# ── Address ───────────────────────────────────────────────────────
# The address people use to open QA TestFlow (used in emailed links).
PUBLIC_URL=http://localhost:8080
# Ports on this machine. For a real domain with automatic HTTPS, set
# SITE_ADDRESS=qa.example.com, HTTP_PORT=80, HTTPS_PORT=443 and PUBLIC_URL=https://qa.example.com
HTTP_PORT=8080
HTTPS_PORT=8443
SITE_ADDRESS=:80

# ── Version ───────────────────────────────────────────────────────
# "latest", or pin a build such as "sha-abc1234" from the package page.
QA_TESTFLOW_VERSION=latest

# ── Database (optional) ───────────────────────────────────────────
POSTGRES_DB=qatool_db
POSTGRES_USER=qatool

# ── Email (optional: verification and password-reset emails) ─────
# Can also be set later in QA TestFlow's Settings page, which takes priority.
# SMTP_URL is the mail server's host name, e.g. smtp.example.com
SMTP_URL=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── ClickUp (optional) ────────────────────────────────────────────
# Leave mock mode on unless you add a real API token.
CLICKUP_API_TOKEN=
CLICKUP_MOCK_MODE=true

# ── Responsive screenshots (optional) ─────────────────────────────
# Comma-separated hosts the screenshot tool may open, e.g. "staging.example.com"
SCREENSHOT_ALLOWED_HOSTS=
